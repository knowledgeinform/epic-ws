	"item": [
		{
			"name": "Active LDAP account",
			"event": [
				{
					"listen": "test",
					"script": {
						"id": "55d4b92f-da42-45fd-892b-f94300a8374b",
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Json Response\", function () {",
							"    pm.response.to.have.jsonBody()",
							"});",
							"",
							"pm.test(\"Access Token Found\", function () {",
							"    pm.expect(pm.response.text()).to.include('accessToken');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"name": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n\t \"username\" : \"change user\",\n\t \"password\" : \"change password\"\n}"
				},
				"url": {
					"raw": "http://localhost:8080/EPIC-WS-0.1-SNAPSHOT/resources/authentication",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8080",
					"path": [
						"EPIC-WS-0.1-SNAPSHOT",
						"resources",
						"authentication"
					]
				}
			},
			"response": []
		},
