    <artifactId>EPIC-WS</artifactId>
    <version>1.8.4-SNAPSHOT</version>
    <packaging>war</packaging>

    <name>EPIC-WS - Electronic Procedure Implementation Catalog Web Service</name>

    <properties>

        <!-- Updated May 2026, many are not the latest, but the latest compatible with Java 8-->
        <log4j.version>2.25.3</log4j.version>
        <mariadb.connector.version>2.7.13</mariadb.connector.version>
        <junit.version>5.14.4</junit.version>
        <junit.platform.version>1.14.4</junit.platform.version>
        <jjwt.version>0.13.0</jjwt.version>
        <lombok.version>1.18.42</lombok.version>
        <lorem.version>2.2</lorem.version>
        <commons-email.version>1.6.0</commons-email.version>
        <commons-io.version>2.21.0</commons-io.version>
        <freemarker.version>2.3.34</freemarker.version>
        <zt-zip.version>1.17</zt-zip.version>
        <javers-core.version>6.14.0</javers-core.version>
        <javers-persistence-sql.version>6.14.0</javers-persistence-sql.version>

        <!-- Not Updated due to complexity-->
        <hibernate.version>5.5.6.Final</hibernate.version>
        <hibernate-search.version>6.1.0.Final</hibernate-search.version>
        <jackson.version>2.7.9</jackson.version>
        <jackson-annotations.version>2.7.9</jackson-annotations.version>
        <jackson-hibernate5.version>2.7.9</jackson-hibernate5.version>
        <jersey.version>2.26</jersey.version> <!-- left at 2.26 for compatibility with jackson 2.7.9-->

        <!-- Not updated but already at the latest available for Hibernate 5 and/or Java 8 -->
        <javax-json.version>1.1.4</javax-json.version>
        <javax-servlet.version>4.0.1</javax-servlet.version>
        <jasypt-spring-boot-starter.version>3.0.5</jasypt-spring-boot-starter.version>

        <!-- Not updated but already at the latest version available -->
        <javers-hibernate.version>1.3.2</javers-hibernate.version>

    </properties>

    <parent>
        <groupId>edu.jhuapl.sd.sig.migs</groupId>
        <artifactId>SIGParent</artifactId>
        <version>1.5.0</version>
    </parent>

    <build>
        <resources>
            <resource>
                <directory>src</directory>
                <includes>
                    <include>META-INF/persistence.xml</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <groupId>org.apache.maven.plugins</groupId>
                <version>3.8.0</version>
                <configuration>
                    <source>1.8</source>
                    <target>1.8</target>
                </configuration>
            </plugin>
            <!-- Create the deployment assembly -->
            <plugin>
                <artifactId>maven-assembly-plugin</artifactId>
                <groupId>org.apache.maven.plugins</groupId>
                <version>3.0.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <appendAssemblyId>false</appendAssemblyId>
                    <descriptors>
                        <descriptor>configAssembly.xml</descriptor>
                    </descriptors>
                    <tarLongFileMode>posix</tarLongFileMode>
                </configuration>
            </plugin>


            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.2.2</version>
                <configuration>
                    <webXml>WebContent/WEB-INF/web.xml</webXml>
                    <webResources>
                        <resource>
                            <directory>WebContent</directory>
                            <includes>
                                <include>**/*</include>
                            </includes>
                        </resource>
                    </webResources>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                            <addDefaultSpecificationEntries>true</addDefaultSpecificationEntries>
                        </manifest>
                        <manifestEntries>
                            <build-date>${maven.build.timestamp}</build-date>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>2.22.2</version>
            </plugin>

            <!-- Code Quality Plugins -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <!-- TODO - Consider adding when quaility updates are made.
                <configuration>
                    <maxAllowedViolations>10</maxAllowedViolations>
                </configuration>
                -->
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.14</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

    <reporting>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
        </plugins>
    </reporting>

