// Default Redhat DevContainer Template.
// For more customization options, see https://containers.dev/implementors/json_reference
{
  "name": "EPIC DevContainer",

  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },

  "privileged": true, // Required for nested Podman (Optional)
  //"securityOpt": ["label=disable"], // Disable SELinux (if needed)
  "capAdd": ["SYS_ADMIN"], // Additional capabilities for storage

  "customizations" : {
    "vscode": {
      "extensions": [ "vscjava.vscode-java-pack" ]
    },
    // Configure JetBrains IDE-specific properties
    "jetbrains" : {
      "backend" : "IntelliJ",
      "settings" : {
        // IDE settings can be added via “Show context actions”|“Add currently modified settings from IDE”.
        // A complete list of supported settings is also available through auto-completion
      },
      "plugins": [
        // A set of plugin IDs.
        // Plugin ID can be found on the corresponding plugin’s page at https://plugins.jetbrains.com.
      ]
    }
  },
  "mounts": [
    "source=${env:HOME}/.ssh,target=/root/.ssh,type=bind,consistency=cached",
    "source=${env:HOME}/.m2,target=/root/.m2,type=bind,consistency=cached"
    //"source=/var/lib/containers,target=/var/lib/containers,type=bind"
  ],
  //"runArgs": ["--storage-driver=vfs"],
  //"postCreateCommand": "echo 'storage.driver = \"vfs\"' >> /etc/containers/storage.conf",
  "features": {
    //"ghcr.io/devcontainers/features/git" : {}
    // Add additional features to your project using auto-completion.
  }
}